<!DOCTYPE html>
<html lang="tl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Liham para kay Jaymee</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html,
    body {
      width: 100%;
      min-height: 100%;
    }

    body {
      background-color: #1a1614;
      background-image:
        radial-gradient(#2c2420 1px, transparent 1px);
      background-size: 20px 20px;

      font-family: Georgia, "Times New Roman", serif;

      min-height: 100vh;

      display: flex;
      justify-content: center;
      align-items: center;

      overflow: hidden;

      user-select: none;
      cursor: pointer;
    }

    /* =========================
       MAIN CONTAINER
    ========================= */

    .letter-container {
      position: relative;

      width: min(90vw, 550px);
      height: min(88vh, 650px);

      perspective: 1200px;
    }

    /* =========================
       PAPER
    ========================= */

    .paper {
      position: absolute;

      inset: 0;

      width: 100%;
      height: 100%;

      background-color: #f4e8c1;

      background-image:
        radial-gradient(
          circle at 50% 50%,
          rgba(255, 255, 255, 0.4),
          rgba(0, 0, 0, 0.15)
        ),
        linear-gradient(
          135deg,
          rgba(0, 0, 0, 0.05) 0%,
          transparent 50%,
          rgba(0, 0, 0, 0.1) 100%
        ),
        repeating-linear-gradient(
          45deg,
          rgba(139, 69, 19, 0.03) 0px,
          rgba(139, 69, 19, 0.03) 2px,
          transparent 2px,
          transparent 4px
        );

      border: 1px solid #d4c391;
      border-radius: 4px;

      padding: 40px;

      box-shadow:
        0 10px 30px rgba(0, 0, 0, 0.5),
        inset 0 0 50px rgba(139, 69, 19, 0.2);

      display: flex;
      flex-direction: column;
      justify-content: center;

      opacity: 0;
      visibility: hidden;

      transform: scale(0.9) rotate(-1deg);

      transition:
        opacity 0.7s ease,
        transform 0.7s ease,
        visibility 0.7s;
    }

    .paper.active {
      opacity: 1;
      visibility: visible;

      transform:
        scale(1)
        rotate(0deg);
    }

    /* =========================
       COVER
    ========================= */

    .folded-cover {
      position: absolute;

      inset: 0;

      width: 100%;
      height: 100%;

      background-color: #e6d5a7;

      background-image:
        radial-gradient(
          circle at 50% 50%,
          rgba(255, 255, 255, 0.3),
          rgba(0, 0, 0, 0.15)
        );

      border: 1px solid #c5b282;

      box-shadow:
        0 15px 35px rgba(0, 0, 0, 0.6);

      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;

      z-index: 10;

      border-radius: 4px;

      transition:
        opacity 0.8s ease,
        transform 0.8s ease,
        visibility 0.8s;
    }

    .folded-cover::before {
      content: "";

      position: absolute;

      inset: 0;

      background:
        linear-gradient(
          135deg,
          transparent 49%,
          rgba(0, 0, 0, 0.1) 50%,
          transparent 51%
        ),
        linear-gradient(
          45deg,
          transparent 49%,
          rgba(0, 0, 0, 0.1) 50%,
          transparent 51%
        );

      pointer-events: none;
    }

    .folded-cover.open {
      opacity: 0;
      visibility: hidden;

      transform:
        translateY(-100px)
        rotateX(90deg);
    }

    /* =========================
       WAX SEAL
    ========================= */

    .wax-seal {
      width: 70px;
      height: 70px;

      background-color: #8b0000;

      background-image:
        radial-gradient(
          circle at 30% 30%,
          #a52a2a,
          #5c0000
        );

      border-radius: 50%;

      display: flex;
      justify-content: center;
      align-items: center;

      color: #d4af37;

      font-size: 24px;
      font-weight: bold;

      box-shadow:
        0 4px 8px rgba(0, 0, 0, 0.4),
        inset 0 0 8px rgba(0, 0, 0, 0.5);

      border: 2px dashed #6b0000;

      margin-bottom: 20px;

      z-index: 2;
    }

    /* =========================
       CLICK HINT
    ========================= */

    .click-hint {
      font-family: "Courier New", Courier, monospace;

      color: #5c4a37;

      font-size: 14px;

      letter-spacing: 2px;

      text-transform: uppercase;

      animation: pulse 1.5s infinite;

      z-index: 2;
    }

    @keyframes pulse {
      0%,
      100% {
        opacity: 0.4;
      }

      50% {
        opacity: 1;
      }
    }

    /* =========================
       TEXT
    ========================= */

    .content {
      color: #2c1d11;

      font-size: 16px;

      line-height: 1.7;

      overflow-y: auto;

      max-height: 100%;
    }

    .content::-webkit-scrollbar {
      width: 5px;
    }

    .content::-webkit-scrollbar-thumb {
      background: #8b6b4d;
      border-radius: 10px;
    }

    p {
      margin-bottom: 12px;
    }

    blockquote {
      font-style: italic;

      margin: 15px 0;

      padding-left: 15px;

      border-left: 2px solid #8b4513;

      color: #4a3525;
    }

    .signature {
      margin-top: 20px;
    }

    /* =========================
       PAGE NUMBER
    ========================= */

    .page-number {
      position: absolute;

      bottom: 15px;
      right: 20px;

      font-size: 12px;

      color: #8b6b4d;

      font-family: Arial, sans-serif;

      pointer-events: none;
    }

    /* =========================
       MOBILE
    ========================= */

    @media (max-width: 600px) {

      .letter-container {
        width: 92vw;
        height: 86vh;
      }

      .paper {
        padding: 25px;
      }

      .content {
        font-size: 14px;
        line-height: 1.6;
      }

      .wax-seal {
        width: 60px;
        height: 60px;
        font-size: 20px;
      }

      .click-hint {
        font-size: 12px;
      }
    }
  </style>
</head>

<body>

